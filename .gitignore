# ---- Qt / qmake 构建产物 ----
debug/
release/
build/
build-*/
Makefile*
.qmake.stash
object_script.*
moc_*
*.moc
qrc_*.cpp
ui_*.h
*.pro.user
*.pro.user.*

# ---- 编译中间文件 / 链接产物 ----
*.o
*.obj
*.res
*.rc.o
*.exe
*.dll
*.a
*.lib
*.exp
*.ilk
*.pdb
*.map

# ---- 编译缓存 / 静态分析 ----
*.gch
*.pch
compile_commands.json
.cache/
.ccache/

# ---- 运行期与本地产物 ----
*.log
*.bak
*.bak-*
*.orig
*.rej
*.tmp
*.swp
*~
.screenshots/

# ---- 发布密钥与签名产物（私钥/清单绝不能入库）----
# update_keys/ 存放清单签名用的 RSA 密钥对（私钥 + 公钥），
# 私钥泄露等于他人可推送任意更新，必须整目录排除。
# 显式写目录名而不只依赖 *.pem：避免将来在该目录放入其它后缀文件时漏网。
update_keys/
*.pem
*.key
*.sig
publish_info/
# 允许发布脚本本身入库
!scripts/publish.ps1
!scripts/setup_server.sh

# ---- 编辑器 / IDE / AI 工具目录（本机配置与助手产物，整目录不入库）----
.vscode/
.idea/
.trae/
.codebuddy/
.workbuddy/
.cursor/
.claude/
.qoder/
.qoder-credits/

# ---- 操作系统杂项 ----
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ---- 打包产物（Enigma Virtual Box 免安装包，随仓库分发）----
# 上面的 *.exe / *.dll 规则针对编译产物；pack/ 下是打包好可直接运行的
# 便携版（exe + Qt 运行库），需要进版本库，这里做例外放行。
!pack/
!pack/**

# packaged release exes (large binaries, not source)
/pack/*.exe

# bundled Qt runtime for EVB packaging
/pack/app_32/
